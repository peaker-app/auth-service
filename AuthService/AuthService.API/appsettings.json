{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDatabase": ""
  },
  "AuthToken": {
    "Issuer": "peaker-auth",
    "Audiences": [ "peaker-gateway", "peaker-auth", "peaker-account", "peaker-ascent" ],
    "SelfAudience": "peaker-auth",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "EmailConfirmation": {
    "FromAddress": "no-reply@peaker.io",
    "FromName": "Peaker",
    "ConfirmationLinkTemplate": "http://localhost:3000/confirm-email?token={token}",
    "PasswordResetLinkTemplate": "http://localhost:3000/reset-password?token={token}",
    "TokenLifetime": "24:00:00",
    "PasswordResetTokenLifetime": "01:00:00",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Username": "",
      "Password": "",
      "Security": "None",
      "Timeout": "00:00:10"
    }
  },
  "EmailQuota": {
    "PerRecipientPerHour": 3,
    "PerRecipientPerDay": 5,
    "GlobalPerHour": 150
  },
  "Terms": {
    "Version": "2026-08-11"
  },
  "DataRetention": {
    "Enabled": true,
    "Interval": "24:00:00",
    "LoginAttempts": "30.00:00:00",
    "EmailDispatches": "30.00:00:00",
    "ClosedSessions": "90.00:00:00",
    "SpentTokens": "30.00:00:00"
  },
  "LoginThrottle": {
    "FreeAttempts": 5,
    "BaseDelay": "00:00:30",
    "MaxDelay": "00:15:00",
    "Window": "00:15:00"
  },
  "Messaging": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Outbox": {
    "PollingInterval": "00:00:10",
    "BatchSize": 20,
    "MaxAttempts": 12,
    "RetryBackoffBase": "00:00:30",
    "RetryBackoffCap": "00:15:00",
    "PendingAgeThreshold": "00:05:00"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
