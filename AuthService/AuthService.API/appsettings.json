{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDatabase": ""
  },
  "AuthToken": {
    "Issuer": "peaker-auth",
    "Audience": "peaker-api",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "EmailConfirmation": {
    "ApiKey": "",
    "FromAddress": "no-reply@peaker.io",
    "FromName": "Peaker",
    "ConfirmationLinkTemplate": "http://localhost:3000/confirm-email?token={token}",
    "TokenLifetime": "24:00:00",
    "RequestTimeout": "00:00:10"
  },
  "Messaging": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Outbox": {
    "PollingInterval": "00:00:10",
    "BatchSize": 20
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
